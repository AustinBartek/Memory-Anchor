{
  "expo": {
    "name": "Memory Anchor",
    "slug": "memory-anchor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hackathon.memoryanchor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Memory Anchor records the places you visit so you can review your daily timeline each evening.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Memory Anchor runs in the background every 30 seconds to build your daily memory journal automatically.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.hackathon.memoryanchor",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Memory Anchor to log your daily stops automatically for your evening memory exercise.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A8A"
        }
      ]
    ]
  }
}